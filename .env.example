PORT=3000
STORE_NAME=Toko Digital
WHATSAPP_NUMBER=62812xxxxxxx
ADMIN_PASSWORD=ganti-password-kuat
SESSION_SECRET=string-acak-panjang
BASE_URL=http://localhost:3000

# Gateway pembayaran: isi minimal satu. Urutan = prioritas, sisanya jadi cadangan otomatis.
PAYMENT_PRIORITY=midtrans,xendit
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Pemasok/agregator (stok cadangan bila stok lokal habis)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Digiflazz mode uji (tanpa memotong saldo): DIGIFLAZZ_TESTING=true
# Agregator lain (API HTTP/JSON sinkron), lihat README:
SUPPLIERS_JSON=

# Pemasok bawaan (aktif otomatis bila env-nya terisi). Preset ber-label "uji sandbox dulu" belum diuji dengan akun nyata.
VIPRESELLER_API_ID=
VIPRESELLER_API_KEY=
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
APIGAMES_MERCHANT_ID=
APIGAMES_SECRET=
# Luar negeri
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
RELOADLY_FALLBACK_EMAIL=
DINGCONNECT_API_KEY=

# Notifikasi (opsional). Pembeli: WhatsApp via Fonnte atau email via Resend. Admin: Telegram.
FONNTE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
