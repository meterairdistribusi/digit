PORT=3000
STORE_NAME=Toko Digital
WHATSAPP_NUMBER=62812xxxxxxx
# Password admin pertama (username: admin). Setelah login, kelola admin di menu Admin.
ADMIN_PASSWORD=ganti-password-kuat
SESSION_SECRET=string-acak-panjang
# Kunci enkripsi untuk kunci API yang disimpan di menu Pengaturan. Jaga tetap stabil (jika berubah, kunci API harus diisi ulang).
# Bila kosong dipakai SESSION_SECRET.
SETTINGS_KEY=
BASE_URL=http://localhost:3000

# Semua kunci di bawah juga bisa diisi dari admin → Pengaturan (disimpan terenkripsi, menimpa env).
# Gateway pembayaran: isi minimal satu. Urutan = prioritas, sisanya jadi cadangan otomatis.
PAYMENT_PRIORITY=midtrans,xendit,tripay,ipaymu
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Tripay (QRIS/VA/e-wallet). TRIPAY_SANDBOX=false hanya setelah uji sandbox lulus.
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_METHOD=QRIS
TRIPAY_SANDBOX=true
# iPaymu. IPAYMU_SANDBOX=false hanya setelah uji sandbox lulus.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_SANDBOX=true

# Pemasok/agregator (stok cadangan bila stok lokal habis)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Digiflazz mode uji (tanpa memotong saldo): DIGIFLAZZ_TESTING=true
# Agregator lain (API HTTP/JSON sinkron), lihat README:
SUPPLIERS_JSON=

# Pemasok bawaan (aktif otomatis bila env-nya terisi). Preset ber-label "uji sandbox dulu" belum diuji dengan akun nyata.
VIPRESELLER_API_ID=
VIPRESELLER_API_KEY=
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
APIGAMES_MERCHANT_ID=
APIGAMES_SECRET=
# Luar negeri
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
RELOADLY_FALLBACK_EMAIL=
DINGCONNECT_API_KEY=

# Notifikasi (opsional). Pembeli: WhatsApp via Fonnte atau email via Resend. Admin: Telegram.
FONNTE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
